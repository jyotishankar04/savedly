# Copy this file to `.env.local` and fill in real values.

# OAuth login (Google/GitHub) is handled entirely server-side — the backend
# owns the client secrets and issues httpOnly cookies, so no OAuth
# credentials belong in this frontend app.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Set to "true" only for a marketing-only preview deployment with no backend
# hosted — /auth, /app, /admin, and /onboard render a static "coming soon"
# placeholder instead of their real (non-functional without a backend) pages.
# Leave unset for a normal full-stack deployment.
NEXT_PUBLIC_SHOWCASE_MODE=false

# FormSubmit target address for the landing page waitlist ("Notify me") —
# the frontend POSTs {name, email} to https://formsubmit.co/ajax/<this
# address>, no backend of ours involved and no account to create. On the
# first real submission FormSubmit emails this address a one-time
# confirmation link — click it to start receiving submissions.
NEXT_PUBLIC_FORMSUBMIT_EMAIL=

# Set to "true" to hide real pricing plans and show a "still being built"
# placeholder in the pricing section instead — independent of showcase mode,
# for when pricing itself just isn't finalized yet. Leave unset to show
# real plans.
NEXT_PUBLIC_BETA_MODE=false

# Public origin of this site, used for absolute URLs in social share previews.
# Optional on Netlify (its build-time URL variable is used when this is unset).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
