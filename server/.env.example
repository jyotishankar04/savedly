# Copy this file to `.env` and fill in real values.

NODE_ENV=development
PORT=4000

# Self-hosted install (see docs/SELF_HOSTING.md and the root
# docker-compose.yml). When true: secrets are generated into SECRETS_DIR on
# first boot, OAuth/R2/SMTP become optional (local disk storage, email off,
# email + password sign-in), the admin can configure services from
# Admin -> Infrastructure, and plan limits are lifted. Leave false for the
# hosted deployment, which is configured only through this file.
# SELF_HOSTED=false
# SECRETS_DIR=./.secrets
# FILES_DIR=./data/files
# TRUST_PROXY=0

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://memora:memora@localhost:5432/memora"

# Also used as the BullMQ ingestion queue's connection. In production this
# can point at Upstash Redis — use their TCP/"regional" connection string,
# not the REST-only serverless one (BullMQ needs blocking commands).
REDIS_URL="redis://localhost:6379"

# SMTP transport for outgoing email — Mailhog in dev (docker-compose's
# `mailhog` service: SMTP on 1025, web UI at http://localhost:8025). All of
# these have working defaults for local Mailhog, so none are required —
# swap in a real provider's values in production, no code change needed.
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS="noreply@saveforlatter.local"
# SMTP_FROM_NAME="SaveForLatter"

# URL of the web client — used for CORS and for the redirect after OAuth login.
FRONTEND_URL="http://localhost:3000"

# This server's own public URL — used to build the OAuth callback redirect_uri.
SERVER_URL="http://localhost:4000"

# JWT signing secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Signs the "password entered" proof cookie for password-protected shared
# links. Generate it the same way, and keep it distinct from both JWT
# secrets above — share tokens are issued to anonymous visitors, so sharing
# a secret with the access token would let a forged one pass authentication.
SHARE_TOKEN_SECRET=""

# Signs the vault-unlock proof cookie. Generate the same way, and keep it
# distinct from every other secret above.
VAULT_TOKEN_SECRET=""

# Google/GitHub OAuth and Cloudflare R2 below are required unless
# SELF_HOSTED=true.
#
# Google OAuth 2.0 client — Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: {SERVER_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth App — https://github.com/settings/developers.
# Authorization callback URL: {SERVER_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare R2 (S3-compatible object storage) — used for the /uploads endpoint
# and memory attachments. Setup: Cloudflare dashboard > R2 > create a bucket >
# enable public access (or attach a custom domain) for R2_PUBLIC_URL > R2 >
# "Manage API tokens" > create a token scoped to that bucket for the key pair.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# The bucket's public r2.dev subdomain, or a custom domain mapped to it.
R2_PUBLIC_URL=""

# Every AI role is bring-your-own-key, configured per-account under
# Settings -> AI (OpenAI/Anthropic/Groq/Google/any OpenAI-compatible
# endpoint) — except embeddings, which the platform pays for directly since
# it's cheap (fractions of a cent per memory) and semantic search shouldn't
# stay dark until someone's configured a key. Optional: leave blank and
# embeddings are BYOK too, same as every other role. A user's own configured
# embeddings credential always takes priority over this when they have one.
EMBEDDINGS_PROVIDER="openai"
EMBEDDINGS_API_KEY=""
EMBEDDINGS_MODEL="text-embedding-3-small"
# Only used when EMBEDDINGS_PROVIDER=custom.
EMBEDDINGS_BASE_URL=""

# Vector storage backend: "pgvector" (default, local/dev — uses the vector
# columns already on this Postgres) or "upstash" (production — decouples
# vector search load from the primary DB). The Upstash vars below are only
# required when VECTOR_STORE_PROVIDER=upstash — get them from the Upstash
# console after creating a Vector index with dimension=1536, metric=cosine.
VECTOR_STORE_PROVIDER="pgvector"
UPSTASH_VECTOR_REST_URL=""
UPSTASH_VECTOR_REST_TOKEN=""

# Langfuse (LLM tracing, self-hosted — the langfuse-* services in
# docker-compose.yml, dev-only). Optional: leave blank to skip tracing
# entirely. These exact keys are auto-provisioned by LANGFUSE_INIT_* in
# docker-compose.yml on first boot — no manual sign-up needed. Dashboard:
# http://localhost:3001 (dev@memora.local / memora-dev-password).
LANGFUSE_PUBLIC_KEY="pk-lf-memora-dev"
LANGFUSE_SECRET_KEY="sk-lf-memora-dev-secret"
LANGFUSE_BASE_URL="http://localhost:3001"

# Calendar OAuth connect (Google Calendar write access + Microsoft/Outlook).
# Google reuses GOOGLE_CLIENT_ID/SECRET above via incremental authorization
# — just enable the Calendar API and approve the calendar.events scope on
# that same GCP OAuth client, no new Google credentials needed. Microsoft
# needs its own Azure AD App Registration (Azure Portal > App registrations
# > New registration; redirect URI {SERVER_URL}/api/v1/integrations/calendar/microsoft/callback;
# grant the delegated Graph permission Calendars.ReadWrite). Both optional —
# leave blank and the corresponding provider's routes 503 cleanly.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# AES-256-GCM key for encrypting stored calendar OAuth tokens at rest — 32
# raw bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional — leave blank and every calendar route 503s cleanly instead of
# crashing.
TOKEN_ENCRYPTION_KEY=""

# Signs the calendar-connect OAuth "state" param. Generate the same way as
# the other token secrets above, and keep it distinct from all of them.
CALENDAR_STATE_SECRET=""

# Included AI — the platform's own chat/vision keys, used for people on a
# plan with an included-AI allowance (Free's monthly taste, "AI included")
# who haven't added their own key. Quota-checked per plan. Set these in
# Admin -> Infrastructure -> Included AI (editable on hosted production too,
# so models can change without a redeploy). Anything set here overrides and
# locks that field in the admin panel. Leave blank to manage them there.
# Provider: openai | anthropic | groq | google | openrouter | custom (custom
# also needs PLATFORM_AI_BASE_URL). A role without its own key reuses the
# reasoning key when the provider is the same. On a self-hosted install
# these give everyone on the instance AI, unlimited.
# PLATFORM_AI_FAST_PROVIDER=openai
# PLATFORM_AI_FAST_API_KEY=
# PLATFORM_AI_FAST_MODEL=gpt-5-nano
# PLATFORM_AI_REASONING_PROVIDER=openai
# PLATFORM_AI_REASONING_API_KEY=
# PLATFORM_AI_REASONING_MODEL=gpt-5-nano
# PLATFORM_AI_VISION_PROVIDER=openai
# PLATFORM_AI_VISION_API_KEY=
# PLATFORM_AI_VISION_MODEL=gpt-5-nano
# PLATFORM_AI_BASE_URL=

# Billing — hosted only (ignored when SELF_HOSTED). Dodo Payments is the
# merchant of record: it handles sales tax/VAT/GST, and takes cards
# worldwide plus UPI (including UPI Autopay subscriptions) in India.
# Dashboard: create one subscription product per paid plan, add a webhook
# pointing at {SERVER_URL}/api/v1/billing/webhook (subscription.* events),
# and copy its signing secret. Keep each product's price equal to the
# plan's price in Admin -> Plans & Limits, then activate the plan there.
# BILLING_PROVIDER=dodo
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PRODUCT_IDS='{"ai-monthly":"pdt_...","ai-yearly":"pdt_..."}'
