{
  "name": "savedly-extension",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:local": "tsc && vite build --mode development",
    "package": "pnpm build && rm -f savedly-extension-*.zip && cd dist && zip -qr ../savedly-extension-$npm_package_version.zip . && cd .. && ls -lh savedly-extension-*.zip"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.435.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.269",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
