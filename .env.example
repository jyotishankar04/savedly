# Root Docker Compose settings. Copy to `.env` in the repository root.
# `PUBLIC_URL` must be the exact URL people use to open the app.
PUBLIC_URL=http://localhost:3000
PORT=3000
TRUST_PROXY=1

# Set a unique password before exposing the server to the internet. Use
# hexadecimal characters because Compose also places this in DATABASE_URL.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Optional server settings. The self-hosted defaults work without these;
# configure any integrations you want to provide centrally.

# S3-compatible file storage (for example Cloudflare R2)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=BUCKET_NAME
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://files.example.com
# S3_FORCE_PATH_STYLE=false

# Upstash Vector (default vector storage uses Postgres/pgvector)
# VECTOR_STORE_PROVIDER=upstash
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=

# SMTP email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@example.com
# SMTP_FROM_NAME=SaveForLatter

# Shared embeddings key; users can also configure their own AI keys in the app
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small

# Optional Google or GitHub sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
