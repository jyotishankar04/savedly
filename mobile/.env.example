# Copy to .env and fill in real values (Expo inlines EXPO_PUBLIC_* at build time).

# The dev server's address as reachable from your phone/emulator — NOT
# "localhost" (that resolves to the device itself, not your dev machine).
# Use your machine's LAN IP (e.g. http://192.168.1.23:4000/api/v1), or a
# tunnel (ngrok) if testing over the internet / a real device on another
# network. Android emulators specifically can also use http://10.0.2.2:4000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Where "Try it on the web" buttons (e.g. the Ask AI coming-soon screen) link to.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
